---
// Lab: false urgency & phantom scarcity.
// Everything alarming on this screen is fabricated client-side, which is exactly the point.
---

<div class="ps">
  <div class="ps__banner" data-ps-banner>
    <strong>Only 1 appointment left</strong> with this practitioner this week!
  </div>

  <div class="ps__card">
    <div class="ps__img" aria-hidden="true">
      <span>◍</span>
    </div>

    <div class="ps__info">
      <p class="ps__kicker">Northgate Physiotherapy · 4.6 ★ (2,481 reviews)</p>
      <h3 class="ps__name">Initial assessment with Dr Okafor</h3>
      <p class="ps__meta">Thu 12 Mar · 09:15 · 45 minutes · in person</p>

      <ul class="ps__signals">
        <li class="ps__signal ps__signal--hot">
          <span aria-hidden="true">🔥</span>
          <span><strong data-ps-viewers>17</strong> people are viewing this slot right now</span>
        </li>
        <li class="ps__signal">
          <span aria-hidden="true">⚡</span>
          <span>Booked <strong data-ps-recent>6</strong> times in the last hour</span>
        </li>
        <li class="ps__signal">
          <span aria-hidden="true">📉</span>
          <span>In high demand — we have <strong>1</strong> slot left</span>
        </li>
      </ul>
    </div>

    <div class="ps__buy">
      <p class="ps__was">$95</p>
      <p class="ps__now money" data-ps-price>$49</p>
      <p class="ps__per">first assessment</p>

      <div class="ps__timer" data-ps-timer-wrap>
        <span class="ps__timer-label">Slot held for</span>
        <span class="ps__clock money" data-ps-clock>04:59</span>
      </div>

      <button class="btn btn--primary btn--block ps__cta" type="button" data-ps-book>
        Book now
      </button>
      <p class="ps__fine">Don't miss out — this time may disappear.</p>
    </div>
  </div>

  <!-- Bait and switch, revealed on booking. -->
  <div class="ps__modal" data-ps-modal hidden>
    <div class="ps__modal-inner" role="alert">
      <p class="ps__modal-title">Someone just took that slot.</p>
      <p class="ps__modal-body">
        Thursday 09:15 with Dr Okafor is no longer available. We found you a similar appointment:
        <strong>Thu 16:30, $69</strong> (evening premium applies).
      </p>
      <div class="ps__modal-actions">
        <button class="btn btn--primary" type="button" data-ps-accept>Book 16:30 for $69</button>
        <button class="btn" type="button" data-ps-decline>No thanks</button>
      </div>
    </div>
  </div>

  <p class="ps__result" data-ps-result hidden></p>

  <div class="demo-note">
    <button class="btn btn--sm" type="button" data-ps-reset>Reset the demo</button>
    <span class="ps__hint">Reset it a few times. Watch the timer, the viewer count, and the "1 left".</span>
  </div>
</div>

<style>
  .ps__banner {
    background: var(--bad-soft);
    color: var(--bad);
    border: 1px solid var(--bad-border);
    border-radius: var(--radius-sm);
    padding: 0.5rem 0.8rem;
    font-size: 0.9rem;
    margin-bottom: 1rem;
    animation: ps-pulse 1.6s ease-in-out infinite;
  }
  @keyframes ps-pulse {
    50% {
      background: color-mix(in srgb, var(--bad-soft) 55%, var(--surface));
    }
  }

  .ps__card {
    display: grid;
    grid-template-columns: 120px minmax(0, 1fr) 190px;
    gap: 1.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1rem;
  }
  @media (max-width: 720px) {
    .ps__card {
      grid-template-columns: 1fr;
    }
    .ps__img {
      display: none;
    }
  }

  .ps__img {
    display: grid;
    place-items: center;
    background: var(--surface-3);
    border-radius: var(--radius-sm);
    color: var(--text-faint);
    font-size: 2rem;
    min-height: 110px;
  }

  .ps__kicker {
    margin: 0 0 0.15rem;
    font-size: 0.8rem;
    color: var(--text-faint);
  }
  .ps__name {
    margin: 0 0 0.2rem;
  }
  .ps__meta {
    margin: 0 0 0.7rem;
    font-size: 0.88rem;
    color: var(--text-muted);
  }

  .ps__signals {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.3rem;
    font-size: 0.85rem;
  }
  .ps__signal {
    display: flex;
    gap: 0.45rem;
    color: var(--text-muted);
  }
  .ps__signal--hot {
    color: var(--bad);
  }

  .ps__buy {
    text-align: right;
    border-left: 1px solid var(--border);
    padding-left: 1.25rem;
  }
  @media (max-width: 720px) {
    .ps__buy {
      border-left: none;
      padding-left: 0;
      border-top: 1px solid var(--border);
      padding-top: 1rem;
      text-align: left;
    }
  }

  .ps__was {
    margin: 0;
    text-decoration: line-through;
    color: var(--text-faint);
    font-size: 0.9rem;
  }
  .ps__now {
    margin: 0;
    font-size: 1.9rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--bad);
  }
  .ps__per {
    margin: 0 0 0.75rem;
    font-size: 0.78rem;
    color: var(--text-faint);
  }

  .ps__timer {
    display: flex;
    align-items: baseline;
    justify-content: flex-end;
    gap: 0.4rem;
    margin-bottom: 0.7rem;
    font-size: 0.82rem;
    color: var(--text-muted);
  }
  @media (max-width: 720px) {
    .ps__timer {
      justify-content: flex-start;
    }
  }
  .ps__clock {
    font-family: var(--font-mono);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--bad);
  }

  .ps__fine {
    margin: 0.5rem 0 0;
    font-size: 0.74rem;
    color: var(--text-faint);
  }

  .ps__modal {
    position: fixed;
    inset: 0;
    background: rgb(0 0 0 / 0.5);
    display: grid;
    place-items: center;
    padding: 1.5rem;
    z-index: 60;
  }
  .ps__modal-inner {
    background: var(--surface);
    border-radius: var(--radius);
    padding: 1.5rem;
    max-width: 420px;
    box-shadow: var(--shadow-lg);
  }
  .ps__modal-title {
    margin: 0 0 0.4rem;
    font-weight: 680;
    font-size: 1.1rem;
  }
  .ps__modal-body {
    margin: 0 0 1.1rem;
    color: var(--text-muted);
    font-size: 0.94rem;
  }
  .ps__modal-actions {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .ps__result {
    margin: 1rem 0 0;
    padding: 0.7rem 0.9rem;
    border-radius: var(--radius-sm);
    background: var(--surface-2);
    border: 1px solid var(--border);
    font-size: 0.92rem;
  }

  .ps__hint {
    margin-left: 0.6rem;
  }
</style>

<script>
  const clock = document.querySelector<HTMLElement>('[data-ps-clock]');
  const viewers = document.querySelector<HTMLElement>('[data-ps-viewers]');
  const recent = document.querySelector<HTMLElement>('[data-ps-recent]');
  const modal = document.querySelector<HTMLElement>('[data-ps-modal]');
  const result = document.querySelector<HTMLElement>('[data-ps-result]');

  let seconds = 299;
  let resets = 0;

  const rand = (min: number, max: number) => Math.floor(Math.random() * (max - min + 1)) + min;

  const paint = () => {
    if (!clock) return;
    const m = String(Math.floor(seconds / 60)).padStart(2, '0');
    const s = String(seconds % 60).padStart(2, '0');
    clock.textContent = `${m}:${s}`;
  };

  // The "urgency" loop: a countdown that quietly restarts, and counters made of noise.
  setInterval(() => {
    seconds -= 1;
    if (seconds < 0) {
      seconds = 299;
      resets += 1;
      if (result && resets === 1) {
        result.hidden = false;
        result.textContent =
          'The countdown just hit zero and started again at 4:59. Nothing expired. No slot was ever held.';
      }
    }
    paint();
  }, 1000);

  setInterval(() => {
    if (viewers) viewers.textContent = String(rand(9, 34));
    if (recent) recent.textContent = String(rand(3, 11));
  }, 2600);

  paint();

  document.querySelector('[data-ps-book]')?.addEventListener('click', () => {
    if (modal) modal.hidden = false;
  });

  const closeModal = (message: string) => {
    if (modal) modal.hidden = true;
    if (result) {
      result.hidden = false;
      result.textContent = message;
    }
  };

  document.querySelector('[data-ps-accept]')?.addEventListener('click', () =>
    closeModal(
      'You paid $69 for an appointment advertised at $49, at a time you did not want. The 09:15 existed to get the click, not to be booked.',
    ),
  );

  document.querySelector('[data-ps-decline]')?.addEventListener('click', () =>
    closeModal(
      'You declined — and the "1 slot left at $49" is still on the page, still bookable, still saying 1.',
    ),
  );

  document.querySelector('[data-ps-reset]')?.addEventListener('click', () => {
    seconds = 299;
    paint();
    if (modal) modal.hidden = true;
    if (result) {
      result.hidden = false;
      result.textContent =
        'Reset. The timer is back to 4:59, the viewer count reshuffled, and there is still exactly 1 slot left.';
    }
  });
</script>
