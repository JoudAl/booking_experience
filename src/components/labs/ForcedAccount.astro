---
// Lab: forced registration, data maximalism, late-revealed rules, bundled consent.
---

<div class="fa">
  <section class="fa__wall" data-fa-panel="wall">
    <div class="fa__lock" aria-hidden="true">🔒</div>
    <h3 class="fa__h">Sign up to see available appointments</h3>
    <p class="fa__sub">
      Registered patients get access to our full diary. Create your free account to see what
      Northgate Physiotherapy has this week.
    </p>
    <p class="fa__blurred">
      Thu 12 Mar · <span class="fa__redact">••:••</span> ·
      <span class="fa__redact">••:••</span> ·
      <span class="fa__redact">••:••</span>
    </p>
    <button class="btn btn--primary" type="button" data-fa-go="form">Create account</button>
    <p class="fa__nolink">Already registered? Sign in</p>
  </section>

  <section class="fa__panel" data-fa-panel="form" hidden>
    <h3 class="fa__h">Create your account</h3>
    <p class="fa__sub">All fields required.</p>

    <form class="fa__form" data-fa-form novalidate>
      <div class="fa__grid">
        <label class="field"><span class="label">First name *</span><input class="input" type="text" data-fa-req /></label>
        <label class="field"><span class="label">Last name *</span><input class="input" type="text" data-fa-req /></label>
        <label class="field"><span class="label">Email *</span><input class="input" type="email" data-fa-req /></label>
        <label class="field"><span class="label">Confirm email *</span><input class="input" type="email" data-fa-req /></label>
        <label class="field">
          <span class="label">Password *</span>
          <input class="input" type="password" data-fa-password data-fa-req />
        </label>
        <label class="field"><span class="label">Mobile number *</span><input class="input" type="tel" data-fa-req /></label>
        <label class="field"><span class="label">Date of birth *</span><input class="input" type="text" placeholder="DD/MM/YYYY" data-fa-req /></label>
        <label class="field"><span class="label">Street address *</span><input class="input" type="text" data-fa-req /></label>
        <label class="field"><span class="label">City *</span><input class="input" type="text" data-fa-req /></label>
        <label class="field"><span class="label">Postal code *</span><input class="input" type="text" data-fa-req /></label>
        <label class="field">
          <span class="label">How did you hear about us? *</span>
          <select class="input" data-fa-req>
            <option value="">Please select</option>
            <option>Search engine</option>
            <option>A friend</option>
            <option>Social media</option>
            <option>Other</option>
          </select>
        </label>
        <label class="field">
          <span class="label">Household income bracket *</span>
          <select class="input" data-fa-req>
            <option value="">Please select</option>
            <option>Under $40,000</option>
            <option>$40,000 – $80,000</option>
            <option>Over $80,000</option>
          </select>
        </label>
      </div>

      <p class="fa__pwrule" data-fa-pwrule hidden>
        Password must be 12+ characters with an uppercase letter, a number, a symbol, and must not
        contain your name.
      </p>

      <label class="fa__consent">
        <input type="checkbox" data-fa-consent />
        <span>
          I agree to the Terms of Service and Privacy Policy, and I agree to receive marketing
          emails, SMS messages and partner offers from Northgate Group and its affiliates. *
        </span>
      </label>

      <p class="fa__error" data-fa-error hidden role="alert"></p>

      <button class="btn btn--primary" type="submit">Create account and see appointments</button>
    </form>
  </section>

  <section class="fa__panel" data-fa-panel="verify" hidden>
    <h3 class="fa__h">Verify your email</h3>
    <p class="fa__sub">
      We've sent a link to your inbox. Appointment times will be visible once your email is
      confirmed.
    </p>
    <div class="fa__inbox">
      <span aria-hidden="true">✉</span>
      <span>Waiting for confirmation…</span>
    </div>
    <button class="btn" type="button" data-fa-go="prices">Pretend you clicked the link</button>
  </section>

  <section class="fa__panel" data-fa-panel="prices" hidden>
    <h3 class="fa__h">Thursday 12 March</h3>
    <ul class="fa__times">
      <li>08:30</li>
      <li>09:15</li>
      <li>13:45</li>
    </ul>
    <p class="fa__price money">$49 <span class="fa__unit">initial assessment, 45 min</span></p>
    <p class="fa__sub">
      Three free slots and a price — the same information the clinic prints on a card in its own
      window, visible to anyone walking past, with no account.
    </p>
    <p class="fa__tally" data-fa-tally></p>
  </section>

  <div class="demo-note">
    <button class="btn btn--sm" type="button" data-fa-reset>Reset the demo</button>
  </div>
</div>

<style>
  .fa__wall {
    text-align: center;
    padding: 2rem 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface-2);
  }
  .fa__lock {
    font-size: 1.8rem;
    margin-bottom: 0.4rem;
  }
  .fa__h {
    margin-bottom: 0.35rem;
  }
  .fa__sub {
    color: var(--text-muted);
    font-size: 0.9rem;
    max-width: 46ch;
    margin-inline: auto;
  }
  .fa__blurred {
    margin: 1rem 0;
    font-size: 1.1rem;
  }
  .fa__redact {
    background: var(--surface-3);
    border-radius: 4px;
    padding: 0 0.3rem;
    color: var(--text-faint);
    filter: blur(0.6px);
  }
  .fa__nolink {
    margin: 0.8rem 0 0;
    font-size: 0.78rem;
    color: var(--text-faint);
    text-decoration: underline;
  }

  .fa__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: 0 1rem;
  }

  .fa__pwrule {
    margin: 0 0 1rem;
    padding: 0.55rem 0.8rem;
    background: var(--bad-soft);
    border: 1px solid var(--bad-border);
    color: var(--bad);
    border-radius: var(--radius-sm);
    font-size: 0.83rem;
  }

  .fa__consent {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.6rem;
    align-items: start;
    font-size: 0.82rem;
    color: var(--text-muted);
    margin: 0.5rem 0 1rem;
    cursor: pointer;
  }
  .fa__consent input {
    margin-top: 0.25rem;
    accent-color: var(--accent);
  }

  .fa__error {
    margin: 0 0 1rem;
    padding: 0.6rem 0.85rem;
    background: var(--bad-soft);
    border: 1px solid var(--bad-border);
    color: var(--bad);
    border-radius: var(--radius-sm);
    font-size: 0.88rem;
  }

  .fa__inbox {
    display: flex;
    gap: 0.6rem;
    align-items: center;
    padding: 0.9rem 1rem;
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius-sm);
    margin: 1rem 0;
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .fa__times {
    list-style: none;
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin: 0 0 0.9rem;
    padding: 0;
  }
  .fa__times li {
    padding: 0.35rem 0.7rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    font-variant-numeric: tabular-nums;
    font-weight: 560;
    background: var(--surface);
  }

  .fa__price {
    font-size: 2.4rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    margin: 0 0 0.3rem;
  }
  .fa__unit {
    font-size: 0.9rem;
    font-weight: 400;
    color: var(--text-faint);
  }
  .fa__tally {
    margin-top: 1rem;
    padding: 0.75rem 0.95rem;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    font-size: 0.9rem;
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('.fa');
  if (root) {
    const panels = [...root.querySelectorAll<HTMLElement>('[data-fa-panel]')];
    const error = root.querySelector<HTMLElement>('[data-fa-error]')!;
    const pwrule = root.querySelector<HTMLElement>('[data-fa-pwrule]')!;
    const started = Date.now();
    let submits = 0;

    const goto = (name: string) => {
      for (const panel of panels) panel.hidden = panel.dataset.faPanel !== name;
      if (name === 'prices') {
        const seconds = Math.max(1, Math.round((Date.now() - started) / 1000));
        root.querySelector<HTMLElement>('[data-fa-tally]')!.textContent =
          `You handed over 12 fields, accepted bundled marketing consent, verified an email address and spent ${seconds} seconds — to find out that Thursday morning is free.`;
      }
    };

    for (const btn of root.querySelectorAll<HTMLElement>('[data-fa-go]')) {
      btn.addEventListener('click', () => goto(btn.dataset.faGo!));
    }

    root.querySelector<HTMLFormElement>('[data-fa-form]')?.addEventListener('submit', (event) => {
      event.preventDefault();
      submits += 1;

      const missing = [...root.querySelectorAll<HTMLInputElement | HTMLSelectElement>('[data-fa-req]')].filter(
        (el) => !el.value.trim(),
      );
      const password = root.querySelector<HTMLInputElement>('[data-fa-password]')!;
      const consent = root.querySelector<HTMLInputElement>('[data-fa-consent]')!;

      if (missing.length) {
        error.hidden = false;
        error.textContent = `${missing.length} required field${
          missing.length === 1 ? ' is' : 's are'
        } incomplete. Every field is required.`;
        missing[0].focus();
        return;
      }

      // The password policy only appears once you have already broken it.
      if (password.value.length < 12) {
        pwrule.hidden = false;
        error.hidden = false;
        error.textContent = 'Your password does not meet our requirements (see above).';
        password.value = '';
        password.focus();
        return;
      }

      if (!consent.checked) {
        error.hidden = false;
        error.textContent =
          'You must accept the terms to continue. (Marketing consent is included in this checkbox and cannot be declined separately.)';
        return;
      }

      error.hidden = true;
      goto('verify');
    });

    root.querySelector('[data-fa-reset]')?.addEventListener('click', () => {
      for (const el of root.querySelectorAll<HTMLInputElement>('.input')) el.value = '';
      const consent = root.querySelector<HTMLInputElement>('[data-fa-consent]');
      if (consent) consent.checked = false;
      error.hidden = true;
      pwrule.hidden = true;
      submits = 0;
      goto('wall');
    });
  }
</script>
