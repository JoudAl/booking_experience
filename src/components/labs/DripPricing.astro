---
// Lab: drip pricing. Mandatory fees arrive one screen at a time.
const service = 49;
const bookingFee = 6;
const adminFee = 25;
const cardFee = Number(((service + bookingFee + adminFee) * 0.029).toFixed(2));
const tax = Number(((service + bookingFee + adminFee + cardFee) * 0.08).toFixed(2));
const total = Number((service + bookingFee + adminFee + cardFee + tax).toFixed(2));
const usd = (n: number) => `$${n.toFixed(2)}`;
---

<div class="dp" data-total={total} data-service={service}>
  <ol class="dp__steps" aria-label="Booking progress">
    <li class="dp__step is-active" data-dp-dot="1">Choose</li>
    <li class="dp__step" data-dp-dot="2">Your details</li>
    <li class="dp__step" data-dp-dot="3">Payment</li>
  </ol>

  <!-- Step 1 -->
  <section class="dp__panel" data-dp-panel="1">
    <div class="dp__room">
      <div>
        <h3 class="dp__title">Initial physiotherapy assessment</h3>
        <p class="dp__sub">Thu 12 Mar · 09:15 · 45 minutes · Dr Okafor</p>
        <p class="dp__sub">Flexible? Same price all week.</p>
      </div>
      <div class="dp__price">
        <p class="dp__amount money">${service}</p>
        <p class="dp__unit">per appointment<span class="dp__ast">*</span></p>
        <button class="btn btn--primary" type="button" data-dp-next="2">Select</button>
      </div>
    </div>
    <p class="dp__legal">*Excludes fees and taxes where applicable.</p>
  </section>

  <!-- Step 2 -->
  <section class="dp__panel" data-dp-panel="2" hidden>
    <h3 class="dp__title">Who is the appointment for?</h3>
    <div class="dp__grid">
      <label class="field">
        <span class="label">Full name</span>
        <input class="input" type="text" autocomplete="name" placeholder="Alex Moreno" />
      </label>
      <label class="field">
        <span class="label">Email</span>
        <input class="input" type="email" autocomplete="email" placeholder="alex@example.com" />
      </label>
      <label class="field">
        <span class="label">Mobile</span>
        <input class="input" type="tel" autocomplete="tel" placeholder="+1 555 0100" />
      </label>
      <label class="field">
        <span class="label">Reason for visit</span>
        <select class="input">
          <option>Back or neck pain</option>
          <option>Sports injury</option>
          <option>Post-operative rehab</option>
          <option>Something else</option>
        </select>
      </label>
    </div>

    <div class="dp__running">
      <span>Initial assessment, 45 min</span>
      <strong class="money">{usd(service)}</strong>
    </div>
    <div class="dp__running dp__running--new">
      <span>Booking fee (mandatory)</span>
      <strong class="money">{usd(bookingFee)}</strong>
    </div>
    <p class="dp__whisper">The booking fee covers our scheduling platform and is non-refundable.</p>

    <button class="btn btn--primary" type="button" data-dp-next="3">Continue to payment</button>
  </section>

  <!-- Step 3 -->
  <section class="dp__panel" data-dp-panel="3" hidden>
    <h3 class="dp__title">Payment</h3>
    <div class="dp__grid">
      <label class="field">
        <span class="label">Card number</span>
        <input class="input" type="text" inputmode="numeric" placeholder="4242 4242 4242 4242" />
      </label>
      <label class="field">
        <span class="label">Expiry</span>
        <input class="input" type="text" placeholder="12 / 28" />
      </label>
    </div>

    <table class="receipt">
      <tbody>
        <tr><td>Initial assessment, 45 min</td><td class="money">{usd(service)}</td></tr>
        <tr><td>Booking fee</td><td class="money">{usd(bookingFee)}</td></tr>
        <tr class="dp__late"><td>New patient admin fee</td><td class="money">{usd(adminFee)}</td></tr>
        <tr class="dp__late"><td>Card processing (2.9%)</td><td class="money">{usd(cardFee)}</td></tr>
        <tr class="dp__late"><td>Tax (8%)</td><td class="money">{usd(tax)}</td></tr>
        <tr class="total"><td>Total due now</td><td class="money">{usd(total)}</td></tr>
      </tbody>
    </table>

    <button class="btn btn--primary btn--block dp__pay" type="button" data-dp-pay>
      Pay {usd(total)} and confirm
    </button>
  </section>

  <p class="dp__verdict" data-dp-verdict hidden></p>

  <div class="demo-note">
    <button class="btn btn--sm" type="button" data-dp-reset>Start over</button>
    <span class="dp__hint">You came in for a ${service} assessment. Keep an eye on the running total.</span>
  </div>
</div>

<style>
  .dp__steps {
    display: flex;
    gap: 0.4rem;
    list-style: none;
    margin: 0 0 1.25rem;
    padding: 0;
    font-size: 0.8rem;
    counter-reset: step;
  }
  .dp__step {
    flex: 1;
    padding: 0.4rem 0.6rem;
    border-radius: var(--radius-sm);
    background: var(--surface-2);
    color: var(--text-faint);
    border: 1px solid var(--border);
    counter-increment: step;
  }
  .dp__step::before {
    content: counter(step) '. ';
  }
  .dp__step.is-active {
    background: var(--accent-soft);
    color: color-mix(in srgb, var(--accent) 70%, var(--text));
    border-color: color-mix(in srgb, var(--accent) 35%, transparent);
    font-weight: 600;
  }

  .dp__room {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.1rem;
  }
  .dp__title {
    margin: 0 0 0.25rem;
  }
  .dp__sub {
    margin: 0;
    font-size: 0.87rem;
    color: var(--text-muted);
  }
  .dp__price {
    text-align: right;
  }
  .dp__amount {
    margin: 0;
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: -0.025em;
  }
  .dp__unit {
    margin: 0 0 0.6rem;
    font-size: 0.78rem;
    color: var(--text-faint);
  }
  .dp__ast {
    color: var(--text-faint);
  }
  .dp__legal {
    margin: 0.6rem 0 0;
    font-size: 0.68rem;
    color: var(--text-faint);
  }

  .dp__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 0 1rem;
    margin-bottom: 0.5rem;
  }

  .dp__running {
    display: flex;
    justify-content: space-between;
    padding: 0.45rem 0;
    border-top: 1px solid var(--border);
    font-size: 0.92rem;
  }
  .dp__running--new {
    color: var(--bad);
  }
  .dp__whisper {
    font-size: 0.72rem;
    color: var(--text-faint);
    margin: 0.3rem 0 1.1rem;
  }

  .dp__late td {
    color: var(--bad);
  }

  .dp__pay {
    margin-top: 1.1rem;
    padding-block: 0.8rem;
    font-size: 1rem;
  }

  .dp__verdict {
    margin: 1rem 0 0;
    padding: 0.8rem 1rem;
    border-radius: var(--radius-sm);
    background: var(--bad-soft);
    border: 1px solid var(--bad-border);
    color: var(--bad);
    font-size: 0.93rem;
  }

  .dp__hint {
    margin-left: 0.6rem;
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('.dp');
  if (root) {
    const total = Number(root.dataset.total);
    const expected = Number(root.dataset.service);

    const goto = (step: string) => {
      for (const panel of root.querySelectorAll<HTMLElement>('[data-dp-panel]')) {
        panel.hidden = panel.dataset.dpPanel !== step;
      }
      for (const dot of root.querySelectorAll<HTMLElement>('[data-dp-dot]')) {
        dot.classList.toggle('is-active', dot.dataset.dpDot === step);
      }
      root.querySelector<HTMLElement>(`[data-dp-panel="${step}"]`)?.scrollIntoView({
        behavior: 'smooth',
        block: 'nearest',
      });
    };

    for (const btn of root.querySelectorAll<HTMLElement>('[data-dp-next]')) {
      btn.addEventListener('click', () => goto(btn.dataset.dpNext!));
    }

    root.querySelector('[data-dp-pay]')?.addEventListener('click', () => {
      const verdict = root.querySelector<HTMLElement>('[data-dp-verdict]');
      if (!verdict) return;
      const uplift = Math.round(((total - expected) / expected) * 100);
      verdict.hidden = false;
      verdict.textContent = `You clicked on a $${expected.toFixed(
        2,
      )} assessment. You paid $${total.toFixed(2)}. That is ${uplift}% more than the price that won your click, and $${(
        total - expected
      ).toFixed(2)} of it appeared after you started filling in the form.`;
      verdict.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    });

    root.querySelector('[data-dp-reset]')?.addEventListener('click', () => {
      const verdict = root.querySelector<HTMLElement>('[data-dp-verdict]');
      if (verdict) verdict.hidden = true;
      goto('1');
    });
  }
</script>
