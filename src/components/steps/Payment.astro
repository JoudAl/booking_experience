---
---

<section data-step="payment" class="page pm" hidden>
  <h1 class="pm__h">Betala</h1>

  <div class="pm__grid">
    <div class="card pm__box">
      <div class="pm__card">
        <span class="pm__brand" aria-hidden="true">VISA</span>
        <span class="pm__num">•••• 4127</span>
        <span class="pill pill--brand">Vald</span>
      </div>
      <button class="optout" type="button" data-pm-other>Annat kort</button>
      <p class="note" data-pm-other-err hidden></p>

      <label class="pm__check">
        <input type="checkbox" checked />
        <span class="tiny">Jag vill inte avstå från nyhetsbrev och erbjudanden.</span>
      </label>

      <div class="pm__drag" data-pm-drag>
        <span class="pm__drag-fill" data-pm-fill></span>
        <span class="pm__drag-text" data-pm-drag-text>Dra för att betala</span>
        <span class="pm__drag-knob" data-pm-knob>›</span>
      </div>
      <p class="note" data-pm-err hidden></p>
    </div>

    <aside class="pm__side">
      <div class="card pm__sum">
        <div class="pm__total"><span>Totalt</span><b data-pm-total>—</b></div>
        <p class="pm__calc tiny faint" data-pm-calc>Beräknar avgifter …</p>

        <details class="acc pm__acc">
          <summary>Specifikation</summary>
          <div class="pm__lines" data-pm-lines></div>
        </details>
      </div>
    </aside>
  </div>
</section>

<!-- The reservation "expires" while you are reading the fees. -->
<div class="overlay" id="pm-expired" hidden>
  <div class="modal" role="dialog" aria-modal="true" aria-labelledby="pm-exp-h">
    <h2 id="pm-exp-h">Tiden gick ut</h2>
    <p class="small muted">Din tid är ombokad. Priset har uppdaterats.</p>
    <button class="btn btn--go btn--lg btn--block" data-pm-exp-ok>Fortsätt</button>
  </div>
</div>

<style>
  .pm {
    padding-block: clamp(1rem, 3vw, 1.75rem);
  }
  .pm__h {
    margin-bottom: 0.9rem;
  }
  .pm__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: clamp(1rem, 3vw, 1.5rem);
    align-items: start;
  }
  @media (max-width: 820px) {
    .pm__grid {
      grid-template-columns: 1fr;
    }
  }
  .pm__box {
    padding: 1rem;
  }
  .pm__card {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    border: 1px solid var(--brand);
    background: var(--brand-soft);
    border-radius: var(--radius-sm);
    padding: 0.8rem 0.95rem;
  }
  .pm__brand {
    flex: none;
    display: grid;
    place-items: center;
    width: 46px;
    height: 30px;
    border-radius: 5px;
    background: #1a1f71;
    color: #fff;
    font-size: 0.7rem;
    font-weight: 800;
    font-style: italic;
  }
  .pm__num {
    flex: 1;
    font-weight: 700;
    letter-spacing: 0.04em;
  }
  .pm__check {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
    margin: 0.9rem 0;
  }
  .pm__check input {
    flex: none;
    margin-top: 0.1rem;
    width: 17px;
    height: 17px;
  }

  /* drag to confirm */
  .pm__drag {
    position: relative;
    height: 56px;
    border-radius: 999px;
    background: var(--surface-3);
    overflow: hidden;
    touch-action: none;
    user-select: none;
  }
  .pm__drag-fill {
    position: absolute;
    inset: 0 auto 0 0;
    width: 56px;
    background: var(--go);
    border-radius: 999px;
  }
  .pm__drag-text {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--text-muted);
    pointer-events: none;
  }
  .pm__drag-knob {
    position: absolute;
    top: 4px;
    left: 4px;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--surface);
    box-shadow: var(--shadow);
    display: grid;
    place-items: center;
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--go-dark);
    cursor: grab;
    touch-action: none;
  }
  .pm__drag-knob:active {
    cursor: grabbing;
  }

  .pm__side {
    position: sticky;
    top: 110px;
  }
  .pm__sum {
    padding: 1rem;
  }
  .pm__total {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }
  .pm__total span {
    font-weight: 600;
  }
  .pm__total b {
    font-size: 1.4rem;
  }
  .pm__calc {
    margin: 0.2rem 0 0.4rem;
    min-height: 1.1em;
  }
  .pm__acc {
    border-top: 1px solid var(--border);
    padding-top: 0.3rem;
  }
  /* Built in JS, so scoped styles cannot reach them. */
  .pm__lines :global(.pm__line) {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.8rem;
    padding: 0.2rem 0;
  }
  .pm__lines :global(.pm__line span) {
    color: var(--text-muted);
  }
</style>

<script>
  import {
    state,
    goTo,
    kr,
    provTotal,
    serviceFee,
    bookingFee,
    cardFee,
    grandTotal,
    OMPROV_PRICE,
    onStep,
    openModal,
    closeModal,
  } from '../../scripts/flow';
  import { provById, extraCopy } from '../../data/booking';

  const lines = document.querySelector<HTMLElement>('[data-pm-lines]');
  const calc = document.querySelector<HTMLElement>('[data-pm-calc]');
  const totalEl = document.querySelector<HTMLElement>('[data-pm-total]');

  let timers: Array<ReturnType<typeof setTimeout>> = [];

  const addLine = (label: string, value: string) => {
    if (!lines) return;
    const row = document.createElement('div');
    row.className = 'pm__line';
    row.innerHTML = `<span>${label}</span><b>${value}</b>`;
    lines.append(row);
  };

  /* The charges arrive one at a time, behind a collapsed accordion.
     Every one of them was decided before the first page load. */
  const buildBreakdown = () => {
    for (const t of timers) clearTimeout(t);
    timers = [];
    if (!lines) return;

    lines.innerHTML = '';
    addLine(provById(state.provtyp)?.name ?? 'Prov', kr(provTotal()));
    if (calc) calc.textContent = 'Beräknar avgifter …';
    if (totalEl) totalEl.textContent = '—';

    const chosen = state.extras.filter((e) => e.on && e.price > 0);
    const steps: Array<() => void> = [
      () => addLine('Serviceavgift', kr(serviceFee())),
      () => addLine('Bokningsavgift', kr(bookingFee())),
      () => addLine('Kallelseavgift', kr(state.kallelseFee)),
      () => addLine(`Omprov × ${state.omprov}`, kr(state.omprov * OMPROV_PRICE)),
      ...chosen.map((e) => () => addLine(extraCopy[e.id]?.name ?? e.id, kr(e.price))),
      () => addLine('Betalningsavgift 2,4 %', kr(cardFee())),
    ];

    steps.forEach((fn, i) => timers.push(setTimeout(fn, 400 + i * 420)));
    timers.push(
      setTimeout(
        () => {
          if (calc) calc.textContent = '';
          if (totalEl) totalEl.textContent = kr(grandTotal());
        },
        400 + steps.length * 420,
      ),
    );
  };

  /* --- drag to pay -------------------------------------------------
     The first completed drag slides back to the start. The second one
     goes through.                                                    */

  const track = document.querySelector<HTMLElement>('[data-pm-drag]');
  const knob = document.querySelector<HTMLElement>('[data-pm-knob]');
  const fill = document.querySelector<HTMLElement>('[data-pm-fill]');
  const label = document.querySelector<HTMLElement>('[data-pm-drag-text]');
  const err = document.querySelector<HTMLElement>('[data-pm-err]');

  let attempts = 0;
  let dragging = false;
  let knobX = 0;

  const place = (x: number) => {
    knobX = x;
    if (knob) knob.style.left = `${x + 4}px`;
    if (fill) fill.style.width = `${x + 56}px`;
  };

  const reset = () => {
    dragging = false;
    place(0);
    if (label) label.textContent = 'Dra för att betala';
  };

  const maxX = () => (track ? Math.max(0, track.clientWidth - 56) : 0);

  knob?.addEventListener('pointerdown', (e) => {
    dragging = true;
    knob.setPointerCapture(e.pointerId);
    if (err) err.hidden = true;
  });

  knob?.addEventListener('pointermove', (e) => {
    if (!dragging || !track) return;
    const x = Math.max(0, Math.min(maxX(), e.clientX - track.getBoundingClientRect().left - 28));
    place(x);
  });

  const release = () => {
    if (!dragging) return;
    dragging = false;

    if (knobX < maxX() * 0.9) {
      reset();
      return;
    }

    attempts += 1;
    if (attempts === 1) {
      if (err) {
        err.hidden = false;
        err.textContent = 'Betalningen avbröts. Försök igen.';
      }
      reset();
      return;
    }
    if (label) label.textContent = 'Betalar …';
    setTimeout(() => goTo('done'), 700);
  };

  knob?.addEventListener('pointerup', release);
  knob?.addEventListener('pointercancel', release);

  onStep('payment', () => {
    reset();
    state.surcharged = false;
    buildBreakdown();

    timers.push(
      setTimeout(() => {
        if (state.step !== 'payment' || state.surcharged) return;
        state.surcharged = true;
        openModal('pm-expired');
      }, 25000),
    );
  });

  document.querySelector('[data-pm-exp-ok]')?.addEventListener('click', () => {
    closeModal('pm-expired');
    buildBreakdown();
  });

  document.querySelector('[data-pm-other]')?.addEventListener('click', () => {
    const el = document.querySelector<HTMLElement>('[data-pm-other-err]');
    if (el) {
      el.hidden = false;
      el.textContent = 'Nya kort läggs till i appen.';
    }
  });
</script>
