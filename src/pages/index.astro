---
import BaseLayout from '../layouts/BaseLayout.astro';
import Chrome from '../components/Chrome.astro';
import CookieWall from '../components/CookieWall.astro';
import Start from '../components/steps/Start.astro';
import Queue from '../components/steps/Queue.astro';
import Booking from '../components/steps/Booking.astro';
import Account from '../components/steps/Account.astro';
import Extras from '../components/steps/Extras.astro';
import Kallelse from '../components/steps/Kallelse.astro';
import Payment from '../components/steps/Payment.astro';
import Done from '../components/steps/Done.astro';
import Help from '../components/steps/Help.astro';
import { site, service } from '../data/booking';
---

<BaseLayout title={`Boka förarprov — ${service.centre} | ${site.name}`}>
  <Chrome />

  <main>
    <Start />
    <Queue />
    <Booking />
    <Account />
    <Extras />
    <Kallelse />
    <Payment />
    <Done />
    <Help />
  </main>

  <CookieWall />

  <script>
    /* Nothing here is real: no request leaves the page, no booking is
       made, no payment is taken. The whole journey is one document, so a
       reload is a clean restart for the next visitor. */
    import { goTo } from '../scripts/flow';

    // Run after every component module has registered its step listeners.
    setTimeout(() => goTo('start'), 0);
  </script>
</BaseLayout>
